# Single root .gitignore for the whole monorepo (frontend/ + backend/)

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files — never commit real secrets, only *.env.example files
.env
.env.local
.env.*.local
backend/.env
frontend/.env*

# next.js (frontend/)
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
.vercel

# backend build output
backend/dist/

# testing / coverage
coverage/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# misc
.DS_Store
*.pem
