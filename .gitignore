# Single root .gitignore for the whole monorepo (frontend/ + backend/)

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files — never commit real secrets, only .env.example
.env
.env.local
.env.*.local

# next.js (frontend/)
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
.vercel

# `next dev` re-scaffolds these inside frontend/ on every run if it doesn't
# find them there (see AGENTS.md / DECISIONS.md) — the real ones live at
# the repo root, these are disposable local duplicates, never commit them.
frontend/AGENTS.md
frontend/CLAUDE.md

# backend build output
backend/dist/

# testing / coverage
coverage/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# misc
.DS_Store
*.pem
