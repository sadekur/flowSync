# Single root .gitignore for the whole monorepo (frontend/ + backend/)

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files — never commit real secrets, only .env.example
.env
.env.local
.env.*.local

# next.js (app lives at the repo root — no frontend/ folder)
.next/
out/
*.tsbuildinfo
next-env.d.ts
.vercel

# backend build output
backend/dist/

# testing / coverage
coverage/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# misc
.DS_Store
*.pem
