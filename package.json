{
  "name": "flowsync",
  "version": "0.1.0",
  "private": true,
  "description": "FlowSync — real-time team collaboration platform (Next.js + Express + Socket.IO + MongoDB + Redis)",
  "scripts": {
    "dev:frontend": "next dev frontend",
    "build:frontend": "next build frontend",
    "start:frontend": "next start frontend",
    "lint:frontend": "eslint --config frontend/eslint.config.mjs frontend",
    "dev:backend": "echo \"backend not yet implemented — see Step 2\" && exit 1",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start:backend": "node backend/dist/server.js",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5.5.0"
  }
}
