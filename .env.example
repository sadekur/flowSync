# Copy to .env at the repo root and fill in real values. Never commit .env.
# One file for the whole monorepo — backend reads the backend-only vars below,
# frontend reads only the NEXT_PUBLIC_* vars (those are the only ones ever
# allowed into the browser bundle; everything else must stay server-only).

# ── Backend (server-only — never expose these) ──────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB — local, or Atlas: mongodb+srv://<user>:<password>@<cluster-host>/flowsync
MONGO_URI=mongodb://127.0.0.1:27017/flowsync

# Redis (presence, cache, rate-limit, Socket.IO adapter)
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate distinct long random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-64
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / cookies — dev only, where the frontend (:3000) and API (:4000) are
# different origins. CORS_ORIGIN must exactly match the frontend origin (no
# wildcard, no trailing slash). Leave BOTH unset for same-origin deploys
# (Vercel, docker-compose + Nginx): no cross-origin access, host-only cookies.
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Email (password reset, …)
# APP_URL is where links in emails point. Optional: falls back to CORS_ORIGIN,
# then on Vercel to the production domain (or a preview's own URL).
# APP_URL=http://localhost:3000
#
# SMTP_URL: unset means dev prints emails to the backend console instead, and
# production refuses to send.
# - Dev: Mailtrap's Email Sandbox catches every email, so nothing is delivered
#   for real. From Sandboxes → your inbox → Integration → SMTP:
#   SMTP_URL=smtp://<username>:<password>@sandbox.smtp.mailtrap.io:2525
# - Production (Vercel env, not this file): Brevo, from SMTP & API → SMTP:
#   SMTP_URL=smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
# SMTP_URL=
# Brevo only sends from a sender verified in its dashboard; Mailtrap takes any.
# MAIL_FROM=FlowSync <you@example.com>

# ── Frontend (safe to expose — bundled into browser JS) ─────────────────────
# Dev: the separate API origin. Leave unset for same-origin deploys, so the
# browser calls its own /api and /socket.io.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server-side only (Server Components → API). Set by the vercel.json service
# binding on Vercel and by docker-compose.yml; dev falls back to NEXT_PUBLIC_API_URL.
# BACKEND_INTERNAL_URL=
