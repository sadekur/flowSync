# Copy to .env at the repo root and fill in real values. Never commit .env.
# One file for the whole monorepo — backend reads the backend-only vars below,
# frontend reads only the NEXT_PUBLIC_* vars (those are the only ones ever
# allowed into the browser bundle; everything else must stay server-only).

# ── Backend (server-only — never expose these) ──────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb+srv://soikut:soikut@cluster0.tauyza2.mongodb.net/flowsync

# Redis (presence, cache, rate-limit, Socket.IO adapter)
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate distinct long random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=7268a6d196e24f232215451b67b575c9b1d462503e2041414a0703cdbbc207f0
JWT_REFRESH_SECRET=d403f4f2242596bec2fdb8d4f31a5fa1882fe9cf64ea3762daf7c2c295e0c9d5
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / cookies — must exactly match the frontend origin (no wildcard, no trailing slash)
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── Frontend (safe to expose — bundled into browser JS) ─────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
